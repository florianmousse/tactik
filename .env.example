# Public: URL et clé publishable (ou anon) du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur uniquement. Jamais de préfixe NEXT_PUBLIC_ !
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile : clé publique ici, clé secrète dans Supabase Auth > CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origine exacte du site, sans slash final (localhost pour le développement).
APP_ORIGIN=http://localhost:3000
# Secret aléatoire >= 32 caractères pour pseudonymiser les IP du rate limiter.
RATE_LIMIT_SECRET=
